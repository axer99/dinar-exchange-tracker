<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= __('compare_meta_description') %>">
  <title><%= __('compare_meta_title') %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<%- include('partials/navbar') %>
<main class="container">

  <div class="page-hero">
    <h1><%= __('compare_hero_title') %></h1>
    <p><%= __('compare_hero_subtitle') %></p>
  </div>

  <div class="pills-section">
    <div class="currency-pills">
      <% for(var i=0; i < CURRENCIES.length; i++) { %>
      <% var cur = CURRENCIES[i] %>
      <a href="/compare?currency=<%= cur %>" class="pill <%= cur === currency ? 'active' : '' %>">
        <%= cur %>
      </a>
      <% } %>
    </div>
  </div>

  <% if(bestRates.bestSell) { %>
  <div class="best-banner">
    <%- __('compare_best_title', bestRates.bestSell.bank) %>
    &nbsp;·&nbsp; <%= bestRates.bestSell.value %> TND
    &nbsp;·&nbsp; <%- __('compare_best_savings', bestRates.savings, currency) %>
  </div>
  <% } %>

  <section class="banks-section">
    <div class="section-header">
      <h2><%= __('compare_table_title', currency) %></h2>
      <span class="section-badge"><%= __('compare_table_badge', comparison.length) %></span>
    </div>
    <table class="banks-table">
      <thead>
        <tr>
          <th><%= __('compare_table_th_rank') %></th>
          <th><%= __('table_th_bank') %></th>
          <th><%= __('table_th_buy') %></th>
          <th><%= __('table_th_sell') %></th>
          <th><%= __('table_th_trend') %></th>
        </tr>
      </thead>
      <tbody>
        <% for(var j = 0; j < comparison.length; j++) { %>
        <tr class="<%= j === 0 ? 'best-row' : '' %>">
          <td>
            <% if(j === 0) { %>
              <span class="rank-badge gold">🥇</span>
            <% } else if(j === 1) { %>
              <span class="rank-badge">🥈</span>
            <% } else if(j === 2) { %>
              <span class="rank-badge">🥉</span>
            <% } else { %>
              <span class="rank-badge"><%= j + 1 %></span>
            <% } %>
          </td>
          <td><strong><%= comparison[j].bankName %></strong></td>
          <td class="rate-buy"><%= comparison[j].buy %></td>
          <td><%= comparison[j].sell %></td>
          <td><%- comparison[j].trend === '▲' ? '<span style="color:var(--primary)">▲</span>' : comparison[j].trend === '▼' ? '<span style="color:var(--danger)">▼</span>' : '<span style="color:var(--text-secondary)">—</span>' %></td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </section>

</main>
<script src="/js/darkmode.js"></script>
</body>
</html>