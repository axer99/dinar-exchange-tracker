<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= __('meta_description') %>">
  <title><%= __('meta_title') %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>

<%- include('partials/navbar') %>

<main class="container">

  <!-- ── Hero ── -->
  <section class="hero">
    <div class="hero-top">
      <div class="live-badge"><div class="live-dot"></div> <%= __('real_time') %></div>
      <h1><%- __('hero_title') %></h1>
      <p><%= __('hero_subtitle') %></p>
    </div>
    <div class="currency-pills">
      <% for(var i = 0; i < CURRENCIES.length; i++) { %>
      <% var cur = CURRENCIES[i] %>
      <a href="/?currency=<%= cur %>" class="pill <%= cur === currency ? 'active' : '' %>">
        <%= cur %>
      </a>
      <% } %>
    </div>
  </section>

  <!-- ── Stats ── -->
  <section class="stats-row">
    <div class="stat-card">
      <div class="stat-icon">💰</div>
      <div class="stat-label"><%= __('stat_best_buy') %></div>
      <div class="stat-value green"><%= bestRates.bestBuy ? bestRates.bestBuy.value : '—' %></div>
      <div class="stat-sub"><%= bestRates.bestBuy ? bestRates.bestBuy.bank : '—' %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🏦</div>
      <div class="stat-label"><%= __('stat_best_sell') %></div>
      <div class="stat-value green"><%= bestRates.bestSell ? bestRates.bestSell.value : '—' %></div>
      <div class="stat-sub"><%= bestRates.bestSell ? bestRates.bestSell.bank : '—' %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon"><%= trend === 'up' ? '📈' : trend === 'down' ? '📉' : '📊' %></div>
      <div class="stat-label"><%= __('stat_trend') %></div>
      <div class="stat-value <%= trend === 'up' ? 'trend-up' : trend === 'down' ? 'trend-down' : 'trend-stable' %>">
        <%= trend === 'up' ? __('trend_up') : trend === 'down' ? __('trend_down') : __('trend_stable') %>
      </div>
      <div class="stat-sub"><%= __(advice) %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">💡</div>
      <div class="stat-label"><%= __('stat_savings') %></div>
      <div class="stat-value green"><%= bestRates.savings %></div>
      <div class="stat-sub"><%= __('savings_sub', currency) %></div>
    </div>
  </section>

  <!-- ── AI Bar ── -->
  <section class="ai-bar">
    <div class="ai-icon">🤖</div>
    <div class="ai-bar-content">
      <strong><%= __('ai_analysis_title') %></strong>
      <%= aiAnalysis %>
    </div>
  </section>

  <!-- ── Banks Table ── -->
  <section class="banks-section">
    <div class="section-header">
      <h2><%= __('table_title', currency) %></h2>
      <span class="section-badge"><%= __('table_badge') %></span>
    </div>
    <table class="banks-table">
      <thead>
        <tr>
          <th><%= __('table_th_bank') %></th>
          <th><%= __('table_th_buy') %></th>
          <th><%= __('table_th_sell') %></th>
          <th><%= __('table_th_trend') %></th>
        </tr>
      </thead>
      <tbody>
        <% for(var j = 0; j < allRates.length; j++) { %>
        <% var bank = allRates[j] %>
        <% var rate = bank.rates.find(function(r){ return r.currency === currency; }) %>
        <% if(rate) { %>
        <tr>
          <td><strong><%= bank.bankName %></strong></td>
          <td class="rate-buy"><%= rate.buy %></td>
          <td><%= rate.sell %></td>
          <td><%- rate.trend === '▲' ? '<span style="color:var(--primary)">▲</span>' : rate.trend === '▼' ? '<span style="color:var(--danger)">▼</span>' : '<span style="color:var(--text-secondary)">—</span>' %></td>
        </tr>
        <% } %>
        <% } %>
      </tbody>
    </table>
  </section>

  <!-- ── Calculator ── -->
  <section class="calculator">
    <div class="calculator-header">
      <div class="stat-icon" style="margin-bottom:0">🧮</div>
      <h2><%= __('calculator_title') %></h2>
    </div>
    <div class="calculator-body">
      <input type="number" id="amount" class="calc-input" value="1000" min="0" step="1">
      <span class="calc-label"><%= currency %></span>
      <span class="calc-equals">=</span>
      <span id="result">—</span>
      <span class="calc-currency">TND</span>
    </div>
  </section>

</main>

<script>
  var bestSell = parseFloat("<%= bestRates.bestSell ? bestRates.bestSell.value : '0' %>");
  var amountInput = document.getElementById('amount');
  var result = document.getElementById('result');
  function updateCalc() {
    var v = parseFloat(amountInput.value);
    result.textContent = isNaN(v) ? '—' : (v * bestSell).toFixed(2);
  }
  amountInput.addEventListener('input', updateCalc);
  updateCalc();
</script>
<script src="/js/darkmode.js"></script>
</body>
</html>